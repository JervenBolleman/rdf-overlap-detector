<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Group id: the reverse of the SIB domain sib.swiss. -->
  <groupId>swiss.sib</groupId>
  <artifactId>rdf-overlap-detector</artifactId>
  <version>0.2.3-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rdf4j.version>6.2.0-M2</rdf4j.version>
    <hardwood.version>1.1.0.Beta2</hardwood.version>
    <junit.version>5.13.4</junit.version>
    <zstd-jni.version>1.5.7-9</zstd-jni.version>
    <slf4j.version>2.0.20</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.eclipse.rdf4j</groupId>
        <artifactId>rdf4j-bom</artifactId>
        <version>${rdf4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.hardwood</groupId>
        <artifactId>hardwood-bom</artifactId>
        <version>${hardwood.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Hardwood lists these codecs as optional, so we declare them for runtime. -->
      <dependency>
        <groupId>com.github.luben</groupId>
        <artifactId>zstd-jni</artifactId>
        <version>${zstd-jni.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- RDF parsing: N-Triples, Turtle, RDF/XML, JSON-LD, with gzip/xz/zstd input via RDFInputDispatcher -->
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-rio-ntriples</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-rio-turtle</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-rio-rdfxml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-rio-jsonld</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-model</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.28.0</version>
    </dependency>
    <!-- Logging: the API, and a simple backend that writes to stderr, configured in simplelogger.properties. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.tukaani</groupId>
      <artifactId>xz</artifactId>
      <version>1.12</version>
    </dependency>
    <dependency>
      <groupId>com.github.luben</groupId>
      <artifactId>zstd-jni</artifactId>
    </dependency>

    <!-- Parquet writing and reading -->
    <dependency>
      <groupId>dev.hardwood</groupId>
      <artifactId>hardwood-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial.snappy</groupId>
      <artifactId>snappy-java</artifactId>
      <version>1.1.10.8</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- One runnable jar with every runtime dependency. Service files are merged rather than overwritten. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- Signatures of the dependency jars are invalid once merged. -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <!-- Per-jar module descriptors cannot be merged onto the classpath. -->
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- Merges META-INF/services files, which RDF4j uses to register parsers, and Hardwood its codecs. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.md</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE-notice.md</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.txt</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.md</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/DEPENDENCIES</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/FastDoubleParser-LICENSE</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/FastDoubleParser-ThirdParty-LICENSE</resource>
                </transformer>
                <!-- Keep every copy of this notice, so each dependency's terms stay in the jar. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/Schubfach-LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Main-Class>swiss.sib.rdfoverlap.Main</Main-Class>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <!-- Platform properties for the native build. zstd-jni ships its native library for each platform in its jar, and
       the native build copies the one for this platform into the image under native/<os>-<arch>/. -->
  <profiles>
    <profile>
      <id>os-linux</id>
      <activation>
        <os><family>unix</family><name>Linux</name></os>
      </activation>
      <properties>
        <dist.os>linux</dist.os>
        <dist.lib.extension>*.so</dist.lib.extension>
        <zstd.os.dir>linux</zstd.os.dir>
      </properties>
    </profile>
    <profile>
      <id>os-mac</id>
      <activation>
        <os><family>mac</family></os>
      </activation>
      <properties>
        <dist.os>macos</dist.os>
        <dist.lib.extension>*.dylib</dist.lib.extension>
        <zstd.os.dir>darwin</zstd.os.dir>
      </properties>
    </profile>
    <profile>
      <id>os-windows</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <properties>
        <dist.os>windows</dist.os>
        <dist.lib.extension>*.dll</dist.lib.extension>
        <zstd.os.dir>win</zstd.os.dir>
      </properties>
    </profile>
    <profile>
      <id>arch-aarch64</id>
      <activation>
        <os><arch>aarch64</arch></os>
      </activation>
      <properties>
        <dist.arch>aarch64</dist.arch>
        <zstd.arch.dir>aarch64</zstd.arch.dir>
      </properties>
    </profile>
    <profile>
      <id>arch-amd64</id>
      <activation>
        <os><arch>amd64</arch></os>
      </activation>
      <properties>
        <dist.arch>x86_64</dist.arch>
        <zstd.arch.dir>amd64</zstd.arch.dir>
      </properties>
    </profile>
    <profile>
      <id>arch-x86_64</id>
      <activation>
        <os><arch>x86_64</arch></os>
      </activation>
      <properties>
        <dist.arch>x86_64</dist.arch>
        <zstd.arch.dir>x86_64</zstd.arch.dir>
      </properties>
    </profile>

    <!-- Opt-in GraalVM native image: mvn -Pnative package. Needs GraalVM 25 as GRAALVM_HOME and a C toolchain. -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <!-- Unpack zstd-jni, to find its native library for this platform. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>unpack-zstd-native</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>com.github.luben</groupId>
                      <artifactId>zstd-jni</artifactId>
                      <version>${zstd-jni.version}</version>
                      <type>jar</type>
                      <overWrite>true</overWrite>
                      <outputDirectory>${project.build.directory}/zstd-native</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- Copy this platform's zstd-jni library into the image as native/<os>-<arch>/libzstd-jni.<ext>. The
               loader in NativeCodecs finds it there, because the native build cannot load it from the jar. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>stage-zstd-native</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <property name="native.resource.dir"
                              value="${project.build.outputDirectory}/native/${dist.os}-${dist.arch}"/>
                    <mkdir dir="${native.resource.dir}"/>
                    <copy todir="${native.resource.dir}">
                      <fileset dir="${project.build.directory}/zstd-native/${zstd.os.dir}/${zstd.arch.dir}"
                               includes="${dist.lib.extension}"/>
                      <firstmatchmapper>
                        <regexpmapper from="^(?:lib)?zstd-jni[^/\\]*\.(so|dylib|dll)$" to="libzstd-jni.\1"/>
                      </firstmatchmapper>
                    </copy>
                    <fail message="Expected one zstd-jni native library in ${native.resource.dir}">
                      <condition>
                        <not>
                          <resourcecount count="1">
                            <fileset dir="${native.resource.dir}" includes="libzstd-jni.*"/>
                          </resourcecount>
                        </not>
                      </condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>0.10.3</version>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <imageName>rdf-overlap-detector</imageName>
              <mainClass>swiss.sib.rdfoverlap.Main</mainClass>
              <buildArgs>
                <!-- A portable instruction set, so the release binaries run on machines other than the build host. -->
                <buildArg>-march=compatibility</buildArg>
                <!-- The zstd loader calls System.load, which needs native access enabled at run time. -->
                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                <!-- JSON-LD parsing needs charsets, such as UTF-32LE, that a native image leaves out by default. -->
                <buildArg>-H:+AddAllCharsets</buildArg>
                <buildArg>--no-fallback</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
              </buildArgs>
              <metadataRepository>
                <enabled>true</enabled>
              </metadataRepository>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
